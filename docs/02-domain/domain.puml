@startuml
!include ../../_style.puml

title Служба такси: модель предметной области

hide circle

package "Пользователи" {

    abstract class Пользователь {
        + id : String
        + имя : String
        + телефон : String
    }

    class Пассажир {
        + датаРегистрации : DateTime
        + зарегистрирован : boolean
    }

    class Водитель {
        + номерЛицензии : String
        + рейтинг : double
        + доступен : boolean
    }

    Пользователь <|-- Пассажир
    Пользователь <|-- Водитель
}

package "Заказы и поездки" {

    class Заказ {
        + номер : String
        + точкаОтправления : String
        + точкаНазначения : String
        + стоимость : Money
        - статус : СтатусЗаказа

        + рассчитатьСтоимость() : Money
        + отменить() : void
    }

    class Поездка {
        + начало : DateTime
        + конец : DateTime
        + итоговаяСтоимость : Money
    }

    class Автомобиль {
        + номер : String
        + модель : String
    }

    class Маршрут {
        + расстояние : double
        + продолжительность : int
    }

    class Оценка {
        + балл : int
        + комментарий : String
        + дата : DateTime
    }

    enum СтатусЗаказа {
        СОЗДАН
        ПОИСК_ВОДИТЕЛЯ
        ПРИНЯТ
        В_ПУТИ
        ЗАВЕРШЕН
        ОТМЕНЕН
    }
}

package "Тарификация и платежи" {

    class Тариф {
        + базоваяСтоимость : Money
        + коэффициентСпроса : double
    }

    class Платёж {
        + номер : String
        + сумма : Money
        - статус : СтатусПлатежа

        + выполнить() : boolean
    }

    enum СтатусПлатежа {
        ОЖИДАЕТ
        УСПЕШЕН
        ОТКЛОНЕН
        ВОЗВРАЩЕН
    }
}

Пассажир "1" -- "0..*" Заказ : оформляет

Водитель "1" -- "0..*" Поездка : выполняет

Водитель "1" -- "0..1" Автомобиль : использует

Заказ "1" *-- "0..1" Поездка : содержит

Поездка "1" -- "1" Маршрут : имеет

Поездка "1" *-- "0..1" Оценка : получает

Поездка "1" -- "1" Автомобиль : выполняется на

Заказ "1" o-- "0..1" Платёж : включает

Заказ ..> Тариф : использует

@enduml