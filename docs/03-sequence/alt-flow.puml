@startuml
!include ../../_style.puml

title ВИ-02 «Заказать поездку»: сценарий с ветвлением

actor "Пассажир" as passenger
participant "Заказ" as order
participant "Маршрут" as route
participant "Водитель" as driver

passenger -> order : указатьТочкуОтправления(адрес)
activate order

alt точка отправления некорректна
    order --> passenger : точка отправления не определена
    order ->> passenger : повторить ввод точки отправления

else точка отправления корректна

    passenger -> order : указатьТочкуНазначения(адрес)
    order -> route : определитьМаршрут(адрес)
    activate route

    alt маршрут не определён
        route --> order : маршрут не определён
        deactivate route
        order ->> passenger : повторить ввод точки назначения

    else маршрут определён
        route --> order : маршрут
        deactivate route

        passenger -> order : подтвердитьЗаказ()

        alt изменился коэффициент стоимости
            order -> order : рассчитатьСтоимость()
            order ->> passenger : новая стоимость

        else коэффициент стоимости не изменился
            order -> order : рассчитатьСтоимость()
            order --> passenger : стоимость
        end

        order -> order : создатьЗаказ()

        alt пассажир отменил заказ
            passenger -> order : отменитьЗаказ()
            order ->> passenger : заказ отменён

        else пассажир не отменил заказ

            alt подходящий водитель найден

                loop пока водитель не назначен

                    order -> driver : получитьПредложение(заказ)
                    activate driver

                    alt водитель принял заказ
                        driver -> driver : принятьЗаказ()
                        driver --> order : заказ принят
                        deactivate driver

                        order -> order : назначитьВодителя(водитель)
                        order -> order : перевестиВСостояниеПринят()

                    else водитель отказался от заказа
                        driver --> order : отказ
                        deactivate driver

                    else ответ не получен 60 секунд
                        deactivate driver
                        order ->> passenger : подбор прекращён, заказ отменён
                        break

                    end

                end

            else подходящий водитель не найден
                order ->> passenger : водитель не найден, заказ остался без назначения

            end
        end
    end
end

deactivate order
@enduml